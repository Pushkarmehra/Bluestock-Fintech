# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyc

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb
*-checkpoint.png

# Data (large/raw files not tracked — see README for fetch instructions)
data/raw/*
data/clean/*
!data/raw/.gitkeep
!data/clean/.gitkeep

# Outputs (regenerated by pipeline; keep curated charts under outputs/charts if desired)
outputs/analytics/*
outputs/advanced/*
!outputs/analytics/.gitkeep
!outputs/advanced/.gitkeep

# Logs
logs/
*.log
pipeline_*.log

# Environment
.env
venv/
.venv/

# OS
.DS_Store
Thumbs.db

# Executed notebook copies generated by run_pipeline.py
*_executed.ipynb

# IDE
.vscode/
.idea/
